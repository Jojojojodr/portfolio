package auth

import (
    "github.com/Jojojojodr/portfolio/frontend"
    "github.com/Jojojojodr/portfolio/frontend/components"

    "github.com/gin-gonic/gin"
)

templ Login(c *gin.Context) {
    @frontend.Layout(c, "Login") {
        <div class="max-w-md mx-auto mt-12">
            <div class="darker-bg rounded-lg p-8 shadow-lg">
                <h1 class="text-2xl font-bold text-white mb-6">Login</h1>
                @components.LoginForm("page", "/")
            </div>
        </div>
    }
}
