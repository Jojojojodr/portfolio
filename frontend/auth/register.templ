package auth

import (
    "github.com/Jojojojodr/portfolio/frontend"
    "github.com/Jojojojodr/portfolio/frontend/components"

    "github.com/gin-gonic/gin"
)

templ RegisterPage(c *gin.Context) {
    @frontend.Layout(c, "Register") {
        <div class="max-w-md mx-auto mt-12">
            <div class="darker-bg rounded-lg p-8 shadow-lg">
                <h1 class="text-2xl font-bold text-white mb-6">Register</h1>
                @components.RegisterForm("page", "/", "", "", map[string]string{})
                <div class="mt-4 text-center">
                    <a href="/login" class="text-blue-400 hover:underline">Already have an account? Login</a>
                </div>
            </div>
        </div>
    }
}
