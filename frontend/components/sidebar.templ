package components

import (
    "fmt"

    "github.com/Jojojojodr/portfolio/database/models"
)

templ BlogSidebar(posts []models.BlogPost) {
    <div id="sidebar-open" class="sidebar-open darker-bg h-10 w-10 flex justify-center items-center rounded">
        <span id="sidebar-open-button">></span>
    </div>
    <div id="sidebar-modal" class="sidebar-modal">
        <aside class="darker-bg w-64 text-white h-screen p-4 overflow-y-auto">
            <div class="flex justify-between">
                <h2 class="text-lg font-bold mb-4">All Blog Posts</h2>
                <span id="sidebar-close-button">X</span>
            </div>
            <ul class="space-y-2">
                if len(posts) == 0 {
                    <li class="text-gray-400">No posts available.</li>
                } else {
                    for _, post := range posts {
                        if post.IsPublished {
                            <li class="hover-bg rounded">
                                <a
                                    href={ templ.SafeURL("/blog/post?id=" + fmt.Sprint(post.ID)) }
                                    hx-get={ templ.SafeURL("/handle/blog/post?id=" + fmt.Sprint(post.ID)) }
                                    hx-target="#blog-post-content"
                                    hx-swap="innerHTML"
                                    hx-push-url={ templ.SafeURL("/blog/post?id=" + fmt.Sprint(post.ID)) }
                                    class="block px-4 py-2"
                                >
                                    { post.Title }
                                </a>
                            </li>
                         }
                    }
                }
            </ul>
        </aside>
    </div>
    <script src="/static/js/sidebar.js"></script>
}
