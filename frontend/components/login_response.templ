package components

templ LoginResponse(success string, err string) {
    if err != "" {
        <div role="alert" class="mb-4 px-4 py-3 rounded-md border border-red-500 bg-red-500/10 text-red-400 text-sm">{ err }</div>
    }
    if success != "" {
        <div role="status" class="mb-4 px-4 py-3 rounded-md border border-green-500 bg-green-500/10 text-green-400 text-sm">{ success }</div>
    }
}
