package components

import (
	"github.com/Jojojojodr/portfolio"

	"github.com/gin-gonic/gin"
)

templ LoginForm(formID string, next string) {
	<div id={ formID + "-login-response" }></div>
	<form hx-post="/handle/auth/login" hx-target={ "#" + formID + "-login-response" } hx-swap="innerHTML" class="space-y-6">
		<input type="hidden" name="next" value={ next }/>
		<div>
			<label for={ formID + "-login-name" } class="block text-sm font-medium text-gray-300 mb-2">Username</label>
			<input
				type="text"
				name="name"
				id={ formID + "-login-name" }
				autocomplete="username"
				class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-md text-white"
			/>
		</div>
		<div>
			<label for={ formID + "-login-password" } class="block text-sm font-medium text-gray-300 mb-2">Password</label>
			<input
				type="password"
				name="password"
				id={ formID + "-login-password" }
				autocomplete="current-password"
				class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-md text-white"
			/>
		</div>
		<button type="submit" class="w-full bg-blue-500 text-white py-2 rounded-md">Login</button>
	</form>
}

templ RegisterForm(formID string, next string, name string, email string, errors map[string]string) {
	<form id={ formID + "-register-form" } hx-post="/handle/register" hx-target="this" hx-swap="outerHTML" class="space-y-6">
		<input type="hidden" name="form_id" value={ formID }/>
		<input type="hidden" name="next" value={ next }/>
		if errors["general"] != "" {
			<div role="alert" class="px-4 py-3 rounded-md border border-red-500 bg-red-500/10 text-red-400 text-sm">{ errors["general"] }</div>
		}
		<div>
			<label for={ formID + "-register-name" } class="block text-sm font-medium text-gray-300 mb-2">Name</label>
			<input
				type="text"
				id={ formID + "-register-name" }
				name="name"
				value={ name }
				autocomplete="username"
				class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-md text-white"
				required
			/>
			if errors["name"] != "" {
				<p class="mt-1 text-sm text-red-400">{ errors["name"] }</p>
			}
		</div>
		<div>
			<label for={ formID + "-register-email" } class="block text-sm font-medium text-gray-300 mb-2">Email</label>
			<input
				type="email"
				id={ formID + "-register-email" }
				name="email"
				value={ email }
				autocomplete="email"
				class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-md text-white"
				required
			/>
			if errors["email"] != "" {
				<p class="mt-1 text-sm text-red-400">{ errors["email"] }</p>
			}
		</div>
		<div>
			<label for={ formID + "-register-password" } class="block text-sm font-medium text-gray-300 mb-2">Password</label>
			<input
				type="password"
				id={ formID + "-register-password" }
				name="password"
				autocomplete="new-password"
				class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-md text-white"
				required
			/>
			if errors["password"] != "" {
				<p class="mt-1 text-sm text-red-400">{ errors["password"] }</p>
			}
		</div>
		<div>
			<label for={ formID + "-register-confirm-password" } class="block text-sm font-medium text-gray-300 mb-2">Confirm password</label>
			<input
				type="password"
				id={ formID + "-register-confirm-password" }
				name="confirm_password"
				autocomplete="new-password"
				class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-md text-white"
				required
			/>
			if errors["confirm_password"] != "" {
				<p class="mt-1 text-sm text-red-400">{ errors["confirm_password"] }</p>
			}
		</div>
		<button
			type="submit"
			class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded shadow font-semibold transition"
		>
			Register
		</button>
	</form>
}

templ AuthModal(c *gin.Context) {
	<dialog id="auth-modal" class="auth-modal darker-bg rounded-lg shadow-lg text-white" aria-labelledby="auth-modal-title">
		<div class="p-8">
			<div class="flex justify-between items-center mb-6">
				<h2 id="auth-modal-title" class="text-2xl font-bold">Account</h2>
				<button type="button" class="text-gray-400 hover:text-white text-2xl leading-none p-2 transition" data-auth-close aria-label="Close">×</button>
			</div>
			if !portfolio.IsAdminRequest(c) {
				<div class="flex gap-2 mb-6" role="tablist">
					<button type="button" role="tab" class="auth-tab" data-auth-tab="login" aria-controls="auth-modal-login">Login</button>
					<button type="button" role="tab" class="auth-tab" data-auth-tab="register" aria-controls="auth-modal-register">Register</button>
				</div>
			}
			<div id="auth-modal-login" role="tabpanel" data-auth-panel="login">
				@LoginForm("modal", authModalNext(c))
			</div>
			if !portfolio.IsAdminRequest(c) {
				<div id="auth-modal-register" role="tabpanel" data-auth-panel="register" hidden>
					@RegisterForm("modal", authModalNext(c), "", "", map[string]string{})
				</div>
			}
		</div>
	</dialog>
}

func authModalNext(c *gin.Context) string {
	switch c.Request.URL.Path {
	case "/login", "/register":
		return "/"
	}
	return c.Request.URL.RequestURI()
}
